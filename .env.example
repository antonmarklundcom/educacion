# ---------------------------------------------------------------------------
# educacion.com.py — copy to .env.local for development.
# In production these are set in hPanel → Environment Variables.
# Paste ONLY the raw value into hPanel's Value field, never "KEY=value".
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Live app (hPanel):  mysql://user:pass@localhost:3306/dbname
# Local dev:          mysql://user:pass@srvXXXX.hstgr.io:3306/dbname
#                     (requires your public IP whitelisted in hPanel → Remote MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/educacion"

# Site ----------------------------------------------------------------------
# Absolute URL, no trailing slash. Used for canonicals, sitemaps and OG images.
# Must be updated + redeployed after the custom domain is mapped.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Privacy -------------------------------------------------------------------
# REQUIRED in production. Min 16 chars, secret, never committed. Salts the
# ip_hash and the daily session hash (docs/architecture.md §6.4).
# Unset: the app warns once and falls back to a random per-process salt, so
# per-IP lead rate limits reset on every restart. Rotating it is the intended
# way to reset IP quotas — it invalidates every existing ip_hash.
# Generate: openssl rand -base64 32
PRIVACY_SALT=""

# Sessions ------------------------------------------------------------------
# iron-session cookie secret. Min 32 chars. Generate: openssl rand -base64 32
# REQUIRED. The app throws on any session read without it — a development
# default would reach production, which is exactly what PR-18 must prevent.
SESSION_SECRET=""

# Cron ----------------------------------------------------------------------
# Shared secret sent as a header by hPanel cron jobs hitting /api/cron/*.
# The route is a routing stub today; each real job ships with its owning PR.
CRON_SECRET=""

# On-demand ISR revalidation --------------------------------------------------
REVALIDATE_SECRET=""

# Email ---------------------------------------------------------------------
# Lead notification delivery (docs/deployment.md §6). Without these a lead is
# still stored, with status='new' and a null delivered_at — nothing is lost,
# the institution just is not told until PR-23's retry cron exists.
# Key from resend.com → API Keys. Sending domain must be verified there.
RESEND_API_KEY=""
LEAD_FROM_EMAIL="educacion.com.py <no-reply@educacion.com.py>"
ADMIN_NOTIFY_EMAIL=""

# File storage (PR-19) ------------------------------------------------------
# Institution logos/photos. NEVER write uploads inside the app directory —
# Hostinger's git deploy wipes it. See docs/risks.md R-08.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Analytics -----------------------------------------------------------------
# Unset means the Plausible script never loads — the correct state until
# someone subscribes. Set to the bare domain, e.g. "educacion.com.py".
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Ingestion -----------------------------------------------------------------
# Polite UA + rate limit for CONES/ANEAES fetches. See docs/data-sources.md §1.
IMPORT_USER_AGENT="educacion.com.py data importer (contacto@educacion.com.py)"
IMPORT_RATE_LIMIT_MS="2000"
